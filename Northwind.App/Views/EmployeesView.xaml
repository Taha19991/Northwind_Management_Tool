<UserControl x:Class="Northwind.App.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Northwind.App.ViewModels"
             xmlns:app="clr-namespace:Northwind.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="Employees" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
                <Border Background="#E3F2FD" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#1565C0" FontSize="12.5" FontWeight="SemiBold">
                        <Run Text="{Binding TotalEmployees, Mode=OneWay}" />
                        <Run Text=" employees" />
                    </TextBlock>
                </Border>
            </StackPanel>

            <Button Command="{Binding LoadEmployeesCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Height="36">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Loading -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Error -->
        <Border Grid.Row="2"
                Style="{StaticResource ErrorBannerStyle}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBannerTextBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Main Content: Left Org Tree + Right Details and Territories -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Organization Hierarchy Tree -->
            <materialDesign:Card Grid.Column="0" Padding="14" UniformCornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Organization Hierarchy" Style="{StaticResource SectionHeaderStyle}" />

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="OnTreeSelectionChanged"
                              BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsCurrent, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="6,5" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}"
                                                      ItemsSource="{Binding DirectReports}">
                                <StackPanel Margin="2,2">
                                    <TextBlock Text="{Binding FullName}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </materialDesign:Card>

            <!-- Right: Employee Info Card + Sales Territories -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Employee Info Card -->
                <materialDesign:Card Grid.Row="0"
                                     Padding="20"
                                     UniformCornerRadius="10"
                                     Visibility="{Binding ActiveEmployee, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="76"
                                Height="76"
                                CornerRadius="38"
                                VerticalAlignment="Top"
                                ClipToBounds="True"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <Image Source="pack://application:,,,/Resources/Icons/placeholder-photo.png"
                                   Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding ActiveEmployee.FullName}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A" />
                            <TextBlock Text="{Binding ActiveEmployee.Title}"
                                       FontSize="13.5"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,2,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Hire Date" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveEmployee.Employee.HireDate, StringFormat={x:Static app:AppFormats.IsoDateBinding}, TargetNullValue=-}"
                                               FontSize="13.5" FontWeight="Medium" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="City" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveEmployee.Employee.City, TargetNullValue=-}"
                                               FontSize="13.5" FontWeight="Medium" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Country" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveEmployee.Employee.Country, TargetNullValue=-}"
                                               FontSize="13.5" FontWeight="Medium" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Extension" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveEmployee.Employee.Extension, TargetNullValue=-}"
                                               FontSize="13.5" FontWeight="Medium" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="Reports To" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveEmployee.ManagerName}"
                                               FontSize="13.5" FontWeight="Medium" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Sales Territories Table -->
                <materialDesign:Card Grid.Row="2" Padding="16" UniformCornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Assigned Sales Territories"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <Border Background="#F1F5F9" CornerRadius="10" Padding="10,2" HorizontalAlignment="Right">
                                <TextBlock FontSize="12" Foreground="#334155">
                                    <Run Text="{Binding Territories.Count, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" territories" />
                                </TextBlock>
                            </Border>
                        </DockPanel>

                        <ProgressBar Grid.Row="1"
                                     IsIndeterminate="True"
                                     Height="3"
                                     Margin="0,0,0,8"
                                     Visibility="{Binding IsLoadingTerritories, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Territories}"
                                  Style="{StaticResource ReadOnlyDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Territory ID" Binding="{Binding TerritoryId}" Width="120" />
                                <DataGridTextColumn Header="Territory Name" Binding="{Binding TerritoryDescription}" Width="1.4*" />
                                <DataGridTextColumn Header="Region" Binding="{Binding RegionDescription}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
