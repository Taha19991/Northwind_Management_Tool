<Window x:Class="Northwind.App.Views.Dialogs.SqlPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SQL Query"
        Width="780"
        Height="440"
        MinWidth="560"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="18">
        <materialDesign:Card Padding="20" UniformCornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Row="0"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,0,0,12" />

                <Border Grid.Row="1"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <TextBox x:Name="SqlTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             FontSize="13.5"
                             Foreground="#E2E8F0"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Border>

                <DockPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock x:Name="CopiedLabel"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="#2E7D32"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"
                               Text="SQL copied to clipboard." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Click="OnCopyClick"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Copy" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Close"
                                Click="OnCloseClick"
                                IsCancel="True"
                                IsDefault="True" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
