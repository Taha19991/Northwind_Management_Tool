<Window x:Class="Northwind.App.Views.Dialogs.NewReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="New Product Return"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="20">
        <materialDesign:Card Padding="22" UniformCornerRadius="10">
            <StackPanel>
                <TextBlock Text="New Product Return" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />

                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,0,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Border Style="{StaticResource ErrorBannerStyle}"
                        Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBannerTextBrush}"
                               TextWrapping="Wrap"
                               FontSize="12.5" />
                </Border>

                <!-- Step 1: Order Lookup -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding OrderIdText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Order Number * (e.g. 10373)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding LoadOrderLinesCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="2"
                            Content="Load Lines"
                            Command="{Binding LoadOrderLinesCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="46"
                            VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{Binding OrderLookupMessage}"
                           Foreground="#C62828"
                           FontSize="12"
                           Margin="2,0,0,10"
                           Visibility="{Binding OrderLookupMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <!-- Step 2 & 3: Order Line, Quantity, Reason, Ticket -->
                <StackPanel Visibility="{Binding HasLoadedOrder, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox ItemsSource="{Binding ReturnableLines}"
                              SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                              DisplayMemberPath="DisplayLabel"
                              materialDesign:HintAssist.Hint="Order Line *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,6,0,12" />

                    <!-- Selected Line Summary -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasSelectedLine, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ordered" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SelectedLine.OrderedQuantity}" FontSize="13.5" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Returned" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SelectedLine.AlreadyReturnedQuantity}" FontSize="13.5" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Remaining" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SelectedLine.RemainingQuantity}" FontSize="13.5" FontWeight="Bold" Foreground="#1565C0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                <TextBlock Text="Est. Refund ($)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding EstimatedRefund, StringFormat={}{0:N2}}" FontSize="13.5" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 materialDesign:HintAssist.Hint="{Binding QuantityHint}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding Reasons}"
                                  SelectedItem="{Binding SelectedReason, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  materialDesign:HintAssist.Hint="Reason *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    </Grid>

                    <ComboBox ItemsSource="{Binding LinkedTickets}"
                              SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              materialDesign:HintAssist.Hint="Link Support Ticket (optional)"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,20" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0" />
                    <Button Content="Create Return"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
