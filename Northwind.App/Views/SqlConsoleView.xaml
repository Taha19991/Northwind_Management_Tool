<UserControl x:Class="Northwind.App.Views.SqlConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Northwind.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="SQL Console" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
                <Border Background="#E8F5E9"
                        BorderBrush="#A5D6A7"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,3"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldLockOutline" Width="14" Height="14" Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Read-only · 15s timeout" Foreground="#1B5E20" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Command="{Binding ToggleSchemaPanelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Height="34">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DatabaseOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Toggle Schema" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Toolbar -->
        <materialDesign:Card Grid.Row="1" Padding="12,8" UniformCornerRadius="10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="RunButton"
                            Click="OnRunClick"
                            IsEnabled="{Binding CanRunQuery}"
                            Height="36"
                            Padding="16,0"
                            Margin="0,0,8,0"
                            ToolTip="Run selected SQL, or full editor (F5 / Ctrl+Enter)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Run (F5)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelQueryCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#C62828"
                            BorderBrush="#C62828"
                            Height="36"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Cancel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearConsoleCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eraser" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Clear" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ComboBox ItemsSource="{Binding Examples}"
                              SelectedItem="{Binding SelectedExample, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              materialDesign:HintAssist.Hint="Load Example Query..."
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Width="255"
                              Height="38"
                              Padding="10,6"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />

                    <ComboBox ItemsSource="{Binding History}"
                              SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="History (last 20)"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Width="210"
                              Height="38"
                              Padding="10,6"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QueryHistoryItem}">
                                <StackPanel Width="320" Margin="0,2">
                                    <DockPanel>
                                        <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#64748B" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding RowSummary}" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding FirstLine}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        DockPanel.Dock="Right"
                        Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDelimitedOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Export CSV" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </materialDesign:Card>

        <!-- Main Workspace: Collapsible Schema Panel + Editor/Results -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SchemaColumnDefinition" Width="270" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Collapsible Schema Browser -->
            <materialDesign:Card Grid.Column="0"
                                 Padding="12"
                                 UniformCornerRadius="10"
                                 Visibility="{Binding IsSchemaPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Schema (public)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left" />
                        <Button Command="{Binding RefreshSchemaCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="28"
                                Height="28"
                                ToolTip="Refresh schema"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right">
                            <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" />
                        </Button>
                    </DockPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding SchemaSearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Filter tables, views, columns..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Padding="10,7"
                             Margin="0,0,0,6" />

                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Margin="0,0,0,4"
                                     Visibility="{Binding IsLoadingSchema, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SchemaSummaryText}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TreeView Grid.Row="3"
                              x:Name="SchemaTreeView"
                              ItemsSource="{Binding SchemaGroups}"
                              BorderThickness="0"
                              MouseDoubleClick="OnSchemaTreeDoubleClick"
                              VirtualizingStackPanel.IsVirtualizing="False">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="Padding" Value="2,2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:SchemaGroupNode}" ItemsSource="{Binding Items}">
                                <HierarchicalDataTemplate.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" />
                                        <Setter Property="Padding" Value="2,1" />
                                    </Style>
                                </HierarchicalDataTemplate.ItemContainerStyle>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:SchemaObjectNode}" ItemsSource="{Binding Columns}">
                                <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="Double-click to insert into editor">
                                    <materialDesign:PackIcon Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Table" />
                                                <Setter Property="Foreground" Value="#1565C0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsView}" Value="True">
                                                        <Setter Property="Kind" Value="EyeOutline" />
                                                        <Setter Property="Foreground" Value="#00838F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding HeaderSummary}" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type vm:SchemaColumnNode}">
                                <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="Double-click to insert column name">
                                    <materialDesign:PackIcon Kind="KeyVariant"
                                                             Width="13"
                                                             Height="13"
                                                             Foreground="#D97706"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,5,0"
                                                             Visibility="{Binding IsPrimaryKey, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DataType}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </materialDesign:Card>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding IsSchemaPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Right: Editor + Status/Error + Result Grid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.44*" MinHeight="140" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.56*" MinHeight="160" />
                </Grid.RowDefinitions>

                <!-- SQL Editor Card -->
                <materialDesign:Card Grid.Row="0" Padding="0" UniformCornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <avalonEdit:TextEditor x:Name="SqlEditor"
                                               Grid.Row="0"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               ShowLineNumbers="True"
                                               WordWrap="False"
                                               Padding="8"
                                               Background="White"
                                               Foreground="#0F172A"
                                               LineNumbersForeground="#94A3B8"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto" />

                        <Border Grid.Row="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,1,0,0"
                                Padding="12,5">
                            <DockPanel>
                                <TextBlock Text="Ctrl+Space: Autocomplete · F5 / Ctrl+Enter: Run · Double-click schema item to insert"
                                           FontSize="11.5"
                                           Foreground="#64748B"
                                           DockPanel.Dock="Left" />
                                <ProgressBar IsIndeterminate="True"
                                             Width="110"
                                             Height="4"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Right"
                                             DockPanel.Dock="Right"
                                             Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Horizontal Splitter -->
                <GridSplitter Grid.Row="1"
                              Height="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="Transparent" />

                <!-- Error Banner -->
                <Border Grid.Row="2"
                        Style="{StaticResource ErrorBannerStyle}"
                        Margin="0,0,0,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBannerTextBrush}"
                               FontFamily="Consolas"
                               FontSize="12.5"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Results Card -->
                <materialDesign:Card Grid.Row="3" Padding="12" UniformCornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Status Bar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       DockPanel.Dock="Left" />

                            <Border Background="#FFF3E0"
                                    BorderBrush="#FFCC80"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding IsResultTruncated, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Showing first 1,000 rows"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#E65100" />
                            </Border>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  x:Name="ResultsDataGrid"
                                  ItemsSource="{Binding ResultView}"
                                  AutoGenerateColumns="True"
                                  AutoGeneratingColumn="OnResultsAutoGeneratingColumn"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="30"
                                  FontSize="12.5"
                                  BorderThickness="1"
                                  BorderBrush="#E2E8F0"
                                  AlternatingRowBackground="#F8FAFC" />
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
