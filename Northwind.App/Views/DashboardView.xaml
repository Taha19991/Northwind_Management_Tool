<UserControl x:Class="Northwind.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">
            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="Dashboard"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <Button Command="{Binding LoadKpisCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border Style="{StaticResource ErrorBannerStyle}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBannerTextBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 5 KPI Cards -->
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Total Net Revenue ($)" Style="{StaticResource KpiLabelStyle}" Margin="0" />
                            <materialDesign:PackIcon Kind="CurrencyUsd" Width="20" Height="20" Foreground="#1565C0" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="34">
                            <TextBlock Text="{Binding TotalNetRevenue, StringFormat={}{0:N2}}"
                                       Style="{StaticResource KpiValueStyle}"
                                       Foreground="#1565C0" />
                        </Viewbox>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Total Orders" Style="{StaticResource KpiLabelStyle}" Margin="0" />
                            <materialDesign:PackIcon Kind="ClipboardListOutline" Width="20" Height="20" Foreground="#283593" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="34">
                            <TextBlock Text="{Binding TotalOrders, StringFormat={}{0:N0}}"
                                       Style="{StaticResource KpiValueStyle}" />
                        </Viewbox>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Open Orders" Style="{StaticResource KpiLabelStyle}" Margin="0" />
                            <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" Foreground="#ED6C02" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="34">
                            <TextBlock Text="{Binding OpenOrders, StringFormat={}{0:N0}}"
                                       Style="{StaticResource KpiValueStyle}"
                                       Foreground="#ED6C02" />
                        </Viewbox>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="3"
                                     Style="{StaticResource KpiCardStyle}"
                                     Cursor="Hand"
                                     ToolTip="Click to view Open &amp; In progress tickets">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenActiveTicketsCommand}" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Open Tickets" Style="{StaticResource KpiLabelStyle}" Margin="0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14" Foreground="#D84315" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.75" />
                                <materialDesign:PackIcon Kind="Lifebuoy" Width="20" Height="20" Foreground="#D84315" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="34">
                            <TextBlock Text="{Binding OpenTickets, StringFormat={}{0:N0}}"
                                       Style="{StaticResource KpiValueStyle}"
                                       Foreground="#D84315" />
                        </Viewbox>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="4" Style="{StaticResource KpiCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Low-Stock Products" Style="{StaticResource KpiLabelStyle}" Margin="0" />
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#C62828" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="34">
                            <TextBlock Text="{Binding LowStockProducts, StringFormat={}{0:N0}}"
                                       Style="{StaticResource KpiValueStyle}"
                                       Foreground="#C62828" />
                        </Viewbox>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- D1: Monthly Net Revenue Line Chart -->
            <materialDesign:Card Padding="20" UniformCornerRadius="10" Margin="0,4,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <TextBlock Text="Monthly Net Revenue ($)"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="12.5"
                                       Foreground="{StaticResource MutedTextBrush}">
                                <Run Text="(" />
                                <Run Text="{Binding MonthlyPointCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" months)" />
                            </TextBlock>
                        </StackPanel>

                        <Button Command="{Binding OpenReportCommand}"
                                CommandParameter="D1_MonthlyRevenue"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Height="30"
                                Padding="10,0"
                                FontSize="12.5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open in Reports" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <materialDesign:PackIcon Kind="OpenInNew" Width="15" Height="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <lvc:CartesianChart Series="{Binding MonthlyRevenueSeries}"
                                        XAxes="{Binding MonthlyRevenueXAxes}"
                                        YAxes="{Binding MonthlyRevenueYAxes}"
                                        Height="280" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Bottom 2-Column Charts: D3 (Late Shipments) + D6 (Top 10 Products) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <!-- D3: Late Shipments by Shipper -->
                <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Late Shipments by Shipper"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                            <Button Command="{Binding OpenReportCommand}"
                                    CommandParameter="D3_LateShipments"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Height="30"
                                    Padding="10,0"
                                    FontSize="12.5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open in Reports" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="15" Height="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <lvc:CartesianChart Series="{Binding LateShipmentsSeries}"
                                            XAxes="{Binding LateShipmentsXAxes}"
                                            YAxes="{Binding LateShipmentsYAxes}"
                                            Height="320" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- D6: Top 10 Products -->
                <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Top 10 Products ($)"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                            <Button Command="{Binding OpenReportCommand}"
                                    CommandParameter="D6_TopProducts"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Height="30"
                                    Padding="10,0"
                                    FontSize="12.5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open in Reports" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="15" Height="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <lvc:CartesianChart Series="{Binding TopProductsSeries}"
                                            XAxes="{Binding TopProductsXAxes}"
                                            YAxes="{Binding TopProductsYAxes}"
                                            Height="320" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
