<UserControl x:Class="Northwind.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="Products" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
                <Border Background="#E3F2FD" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#1565C0" FontSize="12.5" FontWeight="SemiBold">
                        <Run Text="{Binding Products.Count, Mode=OneWay}" />
                        <Run Text=" products" />
                    </TextBlock>
                </Border>
            </StackPanel>

            <Button Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Height="36">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Filter Bar -->
        <materialDesign:Card Grid.Row="1" Padding="14,10" UniformCornerRadius="10" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding CategoryFilters}"
                          SelectedItem="{Binding ActiveCategoryFilter, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="Category"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="210"
                          Margin="0,0,12,0" />

                <ComboBox ItemsSource="{Binding SupplierFilters}"
                          SelectedItem="{Binding ActiveSupplierFilter, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="Supplier"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="240"
                          Margin="0,0,20,0" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <ToggleButton IsChecked="{Binding OnlyLowStock, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center" />
                    <TextBlock Text="Critical stock only"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontSize="13.5" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding ShowDiscontinued, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center" />
                    <TextBlock Text="Show discontinued"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontSize="13.5" />
                </StackPanel>
            </WrapPanel>
        </materialDesign:Card>

        <!-- Loading -->
        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Error -->
        <Border Grid.Row="3"
                Style="{StaticResource ErrorBannerStyle}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBannerTextBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Success -->
        <Border Grid.Row="4"
                Background="#E8F5E9"
                BorderBrush="#A5D6A7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1B5E20" />
        </Border>

        <!-- Main Content: Left Table + Right Form -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Products Table -->
            <materialDesign:Card Grid.Column="0" Padding="12" UniformCornerRadius="10">
                <DataGrid ItemsSource="{Binding Products}"
                          SelectedItem="{Binding ActiveProduct, Mode=TwoWay}"
                          Style="{StaticResource ReadOnlyDataGridStyle}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Discontinued}" Value="True">
                                    <Setter Property="Opacity" Value="0.52" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Product Name" Width="1.6*" SortMemberPath="ProductName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource CriticalBadgeStyle}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Critical"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#C62828" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*" />
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.15*" />
                        <DataGridTextColumn Header="Unit Price ($)" Binding="{Binding UnitPrice, StringFormat={}{0:N2}, TargetNullValue=-}" Width="96">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stock" Binding="{Binding UnitsInStock, TargetNullValue=-}" Width="62">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="On Order" Binding="{Binding UnitsOnOrder, TargetNullValue=-}" Width="78">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel, TargetNullValue=-}" Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Right: Edit Form -->
            <materialDesign:Card Grid.Column="2" Padding="18" UniformCornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding FormHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        <Border Background="#FFF8E1"
                                BorderBrush="#FFE082"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,2"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Read-Only" FontSize="11.5" Foreground="#E65100" />
                        </Border>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,2,6,4">
                            <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     MaxLength="40"
                                     materialDesign:HintAssist.Hint="Product Name *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,0,18" />

                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValue="{Binding CategoryId, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                      SelectedValuePath="CategoryId"
                                      DisplayMemberPath="CategoryName"
                                      IsEnabled="{Binding CanEdit}"
                                      materialDesign:HintAssist.Hint="Category *"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Margin="0,0,0,18" />

                            <ComboBox ItemsSource="{Binding Suppliers}"
                                      SelectedValue="{Binding SupplierId, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                      SelectedValuePath="SupplierId"
                                      DisplayMemberPath="CompanyName"
                                      IsEnabled="{Binding CanEdit}"
                                      materialDesign:HintAssist.Hint="Supplier *"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Margin="0,0,0,18" />

                            <TextBox Text="{Binding QuantityPerUnit, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     MaxLength="20"
                                     materialDesign:HintAssist.Hint="Quantity per Unit (e.g. 10 boxes x 20)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,0,18" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         materialDesign:HintAssist.Hint="Unit Price ($)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding UnitsInStockText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         materialDesign:HintAssist.Hint="Units in Stock"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding UnitsOnOrderText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         materialDesign:HintAssist.Hint="Units on Order"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding ReorderLevelText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         materialDesign:HintAssist.Hint="Reorder Level"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </Grid>

                            <CheckBox Content="Discontinued"
                                      IsChecked="{Binding Discontinued, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      Margin="2,4,0,4" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons (visible only when CanEdit = true) -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="New"
                                Command="{Binding NewProductCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Save"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
