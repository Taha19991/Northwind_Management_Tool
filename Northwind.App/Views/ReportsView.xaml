<UserControl x:Class="Northwind.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:reports="clr-namespace:Northwind.App.Reports">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Reports" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,12" />

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border Grid.Row="2"
                Style="{StaticResource ErrorBannerStyle}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBannerTextBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="3"
                Background="#E8F5E9"
                BorderBrush="#A5D6A7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1B5E20" />
        </Border>

        <!-- Main 2-Column Layout -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: 10-Report Catalog -->
            <materialDesign:Card Grid.Column="0" Padding="10" UniformCornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Report Catalog"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="6,4,6,8" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Catalog}"
                             SelectedItem="{Binding ActiveReport, Mode=TwoWay}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="8,9" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type reports:ReportDefinition}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="#E3F2FD"
                                            CornerRadius="6"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="#1565C0" />
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </materialDesign:Card>

            <!-- Right: Header + Chart + Results Table -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top: Title, Business Question, Parameters, Actions -->
                <materialDesign:Card Grid.Row="0" Padding="18,14" UniformCornerRadius="10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A">
                                    <Run Text="{Binding ActiveReport.Code, Mode=OneWay}" Foreground="#1565C0" />
                                    <Run Text=" — " Foreground="{StaticResource MutedTextBrush}" />
                                    <Run Text="{Binding ActiveReport.Title, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ActiveReport.BusinessQuestion}"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#F1F5F9"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    Visibility="{Binding ExecutionSummary, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding ExecutionSummary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#334155" />
                            </Border>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
                            <!-- Parameter Area (D4 only) -->
                            <DatePicker DockPanel.Dock="Left"
                                        SelectedDate="{Binding ReferenceDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="Reference Date"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        Width="175"
                                        Margin="0,0,12,0"
                                        Visibility="{Binding HasReferenceDateParameter, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <Button DockPanel.Dock="Left"
                                    Command="{Binding RunReportCommand}"
                                    Height="38"
                                    Padding="16,0"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlayOutline" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Run" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button DockPanel.Dock="Right"
                                    Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="38"
                                    Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Export CSV" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button DockPanel.Dock="Right"
                                    Command="{Binding ShowSqlCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="38"
                                    Padding="14,0"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CodeTags" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Show SQL" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Middle: Chart (hidden for table-only reports) -->
                <materialDesign:Card Grid.Row="1"
                                     Padding="16"
                                     UniformCornerRadius="10"
                                     Margin="0,0,0,12"
                                     Visibility="{Binding HasChart, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Height="290">
                        <lvc:CartesianChart Series="{Binding CartesianSeries}"
                                            XAxes="{Binding CartesianXAxes}"
                                            YAxes="{Binding CartesianYAxes}"
                                            LegendPosition="{Binding CartesianLegendPosition}"
                                            Visibility="{Binding IsCartesianChart, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <lvc:PieChart Series="{Binding PieSeries}"
                                      LegendPosition="{Binding PieLegendPosition}"
                                      Visibility="{Binding IsPieChart, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </materialDesign:Card>

                <!-- Bottom: Results DataGrid -->
                <materialDesign:Card Grid.Row="2" Padding="12" UniformCornerRadius="10">
                    <DataGrid ItemsSource="{Binding ResultRows}"
                              Style="{StaticResource ReadOnlyDataGridStyle}"
                              AutoGenerateColumns="True"
                              AutoGeneratingColumn="OnAutoGeneratingColumn" />
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
