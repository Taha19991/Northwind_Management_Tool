<UserControl x:Class="Northwind.App.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Northwind.App"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="Returns" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
                <Border Background="#E3F2FD" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#1565C0" FontSize="12.5" FontWeight="SemiBold">
                        <Run Text="{Binding Returns.Count, Mode=OneWay}" />
                        <Run Text=" returns" />
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Command="{Binding OpenNewReturnCommand}"
                        Margin="0,0,10,0"
                        Height="36"
                        Visibility="{Binding CanManageReturns, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="New Return" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Status Filter Chips -->
        <materialDesign:Card Grid.Row="1" Padding="12,10" UniformCornerRadius="10" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding FilterChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding DisplayText}"
                                Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Height="34"
                                Padding="14,0"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#1565C0" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderBrush" Value="#1565C0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </materialDesign:Card>

        <!-- Loading -->
        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Error -->
        <Border Grid.Row="3"
                Style="{StaticResource ErrorBannerStyle}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBannerTextBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Status Message -->
        <Border Grid.Row="4"
                Background="#E8F5E9"
                BorderBrush="#A5D6A7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1B5E20" />
        </Border>

        <!-- Main Content: Left Returns Table + Right Detail & Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Returns Table -->
            <materialDesign:Card Grid.Column="0" Padding="12" UniformCornerRadius="10">
                <DataGrid ItemsSource="{Binding Returns}"
                          SelectedItem="{Binding ActiveReturn, Mode=TwoWay}"
                          Style="{StaticResource ReadOnlyDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Return ID" Binding="{Binding ReturnId}" Width="78" />
                        <DataGridTextColumn Header="Date" Binding="{Binding ReturnDate, StringFormat={x:Static app:AppFormats.IsoDateBinding}}" Width="94" />
                        <DataGridTextColumn Header="Order" Binding="{Binding OrderId}" Width="68" />
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="1.35*" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="52">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Reason" Binding="{Binding ReasonText}" Width="0.95*" />
                        <DataGridTemplateColumn Header="Status" Width="98" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="White"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Refund ($)" Binding="{Binding RefundAmount, StringFormat={}{0:N2}}" Width="92">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Restocked" Binding="{Binding RestockedText}" Width="82" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Right: Detail & Actions Panel -->
            <materialDesign:Card Grid.Column="2" Padding="18" UniformCornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <Run Text="Return #" />
                                <Run Text="{Binding ActiveReturn.ReturnId, TargetNullValue=-}" />
                            </TextBlock>

                            <Border Background="{Binding ActiveReturn.Status, Converter={StaticResource StatusToBrushConverter}}"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding ActiveReturn.StatusText}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </DockPanel>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveReturn.ProductName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0">
                                        <Run Text="Order #" />
                                        <Run Text="{Binding ActiveReturn.OrderId}" FontWeight="SemiBold" Foreground="#334155" />
                                        <Run Text=" · Qty: " />
                                        <Run Text="{Binding ActiveReturn.Quantity}" FontWeight="SemiBold" Foreground="#334155" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Return Date" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveReturn.ReturnDate, StringFormat={x:Static app:AppFormats.IsoDateBinding}}"
                                               FontSize="13" FontWeight="Medium" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Refund Amount ($)" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveReturn.RefundAmount, StringFormat={}{0:N2}, TargetNullValue='0.00'}"
                                               FontSize="14.5" FontWeight="Bold" Foreground="#1565C0" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Reason" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveReturn.ReasonText}" FontSize="13" FontWeight="Medium" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="Restocked" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveReturn.RestockedText}" FontSize="13" FontWeight="Medium" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="Linked Ticket" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding LinkedTicketDisplay}" FontSize="13" FontWeight="Medium" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="1">
                                    <TextBlock Text="Processed By" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveReturn.ProcessedByName, TargetNullValue=-}" FontSize="13" FontWeight="Medium" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,2,0,14" />

                            <TextBlock Text="Actions" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" />

                            <WrapPanel Orientation="Horizontal">
                                <Button Command="{Binding ApproveCommand}"
                                        Margin="0,0,8,8"
                                        Height="36"
                                        Background="#2E7D32"
                                        BorderBrush="#2E7D32"
                                        Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Approve" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RejectCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="#C62828"
                                        BorderBrush="#C62828"
                                        Margin="0,0,8,8"
                                        Height="36"
                                        Visibility="{Binding CanReject, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Reject" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding MarkRefundedCommand}"
                                        Margin="0,0,8,8"
                                        Height="36"
                                        Visibility="{Binding CanMarkRefunded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashRefund" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Mark Refunded" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ReturnToStockCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,8"
                                        Height="36"
                                        Visibility="{Binding CanReturnToStock, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PackageVariantPlus" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Return to Stock" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <TextBlock Text="No actions are available for this return with your role and its current status."
                                       FontSize="12.5"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding HasNoAction, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
