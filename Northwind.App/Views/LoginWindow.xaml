<Window x:Class="Northwind.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Northwind — Sign In"
        Width="420"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="24">
        <materialDesign:Card Padding="28" UniformCornerRadius="12" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Border Width="54"
                            Height="54"
                            CornerRadius="27"
                            Background="{DynamicResource PrimaryHueMidBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="StorefrontOutline"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Northwind Management Panel"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in to continue"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TextBox x:Name="UsernameTextBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Username"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,14" />

                <PasswordBox x:Name="PasswordInput"
                             PasswordChanged="OnPasswordChanged"
                             materialDesign:HintAssist.Hint="Password"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Margin="0,0,0,12" />

                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBannerTextBrush}"
                               TextWrapping="Wrap"
                               FontSize="12.5" />
                </Border>

                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Margin="0,4,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="Sign In"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="42"
                        Margin="0,8,0,0"
                        IsEnabled="{Binding IsNotBusy}" />

                <TextBlock Text="Demo accounts: manager · sales · logistics · support"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
