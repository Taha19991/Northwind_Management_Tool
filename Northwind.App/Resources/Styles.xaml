<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E0E6ED" />
    <SolidColorBrush x:Key="ErrorBannerBackgroundBrush" Color="#FFEBEE" />
    <SolidColorBrush x:Key="ErrorBannerBorderBrush" Color="#EF9A9A" />
    <SolidColorBrush x:Key="ErrorBannerTextBrush" Color="#B71C1C" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6B7A" />

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="KpiCardStyle" TargetType="materialDesign:Card">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="UniformCornerRadius" Value="10" />
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>

    <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#0F172A" />
    </Style>

    <Style x:Key="ErrorBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrorBannerBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBannerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="CriticalBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFEBEE" />
        <Setter Property="BorderBrush" Value="#E57373" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ReadOnlyDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="Background" Value="White" />
    </Style>

</ResourceDictionary>
